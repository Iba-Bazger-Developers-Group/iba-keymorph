<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\..\assets\keymorph.ico</ApplicationIcon>
    <AssemblyName>IbaKeyMorph</AssemblyName>
    <RootNamespace>IbaKeyMorph</RootNamespace>
    <AssemblyTitle>IBA KeyMorph</AssemblyTitle>
    <!-- Precompiled code: the first keystroke must not wait for the JIT (see KeyMorphService.WarmUp). -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\keymorph.ico" LogicalName="IbaKeyMorph.Assets.keymorph.ico" />
    <EmbeddedResource Include="..\..\assets\switch.wav" LogicalName="IbaKeyMorph.Assets.switch.wav" />
    <EmbeddedResource Include="..\..\assets\panda-logo.png" LogicalName="IbaKeyMorph.Assets.panda.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IbaKeyMorph.Core\IbaKeyMorph.Core.csproj" />
  </ItemGroup>

</Project>
